POSTGRES_DB=pmp
POSTGRES_USER=pmp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a unique key of at least 50 characters outside debug mode; never commit .env.
DJANGO_SECRET_KEY=replace-me-with-a-unique-random-secret-of-at-least-50-characters
DJANGO_DEBUG=0
ALLOWED_HOSTS=*
REDIS_URL=redis://redis:6379/0
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@pmp.local
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
