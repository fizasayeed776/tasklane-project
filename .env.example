POSTGRES_DB=pmp
POSTGRES_USER=pmp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
# Replace this placeholder before the first `docker compose up --build` when DJANGO_DEBUG=0.
# Generate with Docker: docker compose run --rm --no-deps backend python -c "import secrets; print(secrets.token_urlsafe(64))"
# If startup rejects the placeholder, put the generated 50+ character key in .env.
# Never commit .env.
DJANGO_SECRET_KEY=replace-me-with-a-unique-random-secret-of-at-least-50-characters
DJANGO_DEBUG=0
ALLOWED_HOSTS=*
REDIS_URL=redis://redis:6379/0
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ── Email ─────────────────────────────────────────────────────────────────────
# Leave EMAIL_BACKEND as the console backend (default) to print emails to the
# Docker log.  Switch to the SMTP backend and fill in the fields below to send
# real email (required for invitation links to reach inboxes).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@pmp.local

# SMTP — only used when EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Gmail app-password example (create one at myaccount.google.com/apppasswords):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=youraddress@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
#   EMAIL_USE_TLS=1
#   EMAIL_USE_SSL=0
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_TIMEOUT=10

# For local dev with Mailpit (see docker-compose.yml dev-mail profile):
#   EMAIL_HOST=mailpit
#   EMAIL_PORT=1025
#   EMAIL_USE_TLS=0

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# This value is inlined in the production frontend at image build time.
# Rebuild the frontend with `docker compose up --build` after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000
